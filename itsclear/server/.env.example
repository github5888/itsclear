# Server Port (Local: 5001, Production VPS: 3046)
PORT=5001

# MongoDB Database Connection
# Local: mongodb://127.0.0.1:27017/itsclear
# Production VPS (Docker container 'itsclear-db' on host port 27052): mongodb://127.0.0.1:27052/itsclear
MONGODB_URI=mongodb://127.0.0.1:27017/itsclear

# Security & Secrets
JWT_SECRET=your_jwt_secret_key_here
OTP_PEPPER=your_32_byte_hex_otp_pepper_here
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://your-store-domain.example
API_RATE_LIMIT=300
COD_ENABLED=true

# Initial admin is created only when both values are supplied. Remove the password after first login.

ADMIN_PHONE=+910000000000

# Razorpay live/test credentials. The secret is server-only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Optional delivery partner defaults; leave blank if assigned by an external logistics system.
DEFAULT_DRIVER_NAME=
DEFAULT_DRIVER_PHONE=
DEFAULT_DRIVER_VEHICLE=

# Google Identity Services OAuth 2.0 Client ID (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Resend Transactional Email Provider (https://resend.com)
# Create account at https://resend.com, verify your domain, and generate an API key
RESEND_API_KEY=re_your_resend_api_key_here
# Use 'itsclear <onboarding@resend.dev>' for testing, or your verified domain e.g. 'itsclear <support@itsclear.in>'
ITS_CLEAR_EMAIL_FROM=itsclear <onboarding@resend.dev>

# Zero-cost email option: Gmail SMTP with a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-business-email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=itsclear <your-business-email@gmail.com>
